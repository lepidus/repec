msgid "plugins.generic.repec.displayName"
msgstr "Gerador de ReDIF para RePEc"

msgid "plugins.generic.repec.description"
msgstr "Publica metadados da revista em formato ReDIF para indexação no RePEc."

msgid "plugins.generic.repec.settings.description"
msgstr "Configure os dados mínimos do arquivo RePEc da revista. O plugin publica dinamicamente os arquivos exigidos pelo RePEc para artigos publicados e infere os demais campos a partir das configurações da revista no OJS."

msgid "plugins.generic.repec.settings.publicUrl"
msgstr "URL pública:"

msgid "plugins.generic.repec.settings.archive"
msgstr "Arquivo RePEc"

msgid "plugins.generic.repec.settings.series"
msgstr "Série ou revista"

msgid "plugins.generic.repec.settings.maintainer"
msgstr "Mantenedor"

msgid "plugins.generic.repec.settings.requiredData"
msgstr "Dados necessários para configuração do plugin RePEc"

msgid "plugins.generic.repec.settings.repecScopeNotice"
msgstr "O RePEc é voltado à literatura de Economia e ciências relacionadas. Antes de publicar qualquer arquivo RePEc, siga as"

msgid "plugins.generic.repec.settings.repecScopeNoticeLink"
msgstr "instruções oficiais passo a passo do RePEc"

msgid "plugins.generic.repec.settings.archiveCode"
msgstr "Código de arquivo atribuído oficialmente pelo RePEc"

msgid "plugins.generic.repec.settings.archiveCodeDescription"
msgstr "Não invente este código nem use um código pertencente a outra instituição. Solicite o código de arquivo ao RePEc antes de configurar o plugin."

msgid "plugins.generic.repec.settings.archiveName"
msgstr "Nome do arquivo"

msgid "plugins.generic.repec.settings.archiveDescription"
msgstr "Descrição"

msgid "plugins.generic.repec.settings.seriesCode"
msgstr "Código de 6 caracteres para a série (revista)"

msgid "plugins.generic.repec.settings.seriesCodeDescription"
msgstr "Você pode preencher manualmente ou usar a sugestão automática. Depois de publicado no RePEc, evite mudar esse código."

msgid "plugins.generic.repec.settings.generateSeriesCode"
msgstr "Gerar automaticamente"

msgid "plugins.generic.repec.settings.seriesName"
msgstr "Nome da série ou revista"

msgid "plugins.generic.repec.settings.providerName"
msgstr "Nome do provedor"

msgid "plugins.generic.repec.settings.providerHomepage"
msgstr "Página inicial do provedor"

msgid "plugins.generic.repec.settings.providerInstitution"
msgstr "Handle RePEc da instituição"

msgid "plugins.generic.repec.settings.maintainerName"
msgstr "Nome do mantenedor"

msgid "plugins.generic.repec.settings.maintainerEmail"
msgstr "E-mail do mantenedor"

msgid "plugins.generic.repec.settings.maintainerEmailDescription"
msgstr "Opcional. Se ficar vazio, o plugin usará o e-mail de suporte técnico configurado na revista no OJS; se ele também estiver vazio, usará o e-mail de contato principal da revista."

msgid "plugins.generic.repec.settings.maintainerEmailGlobalDescription"
msgstr "Obrigatório. Será usado como e-mail do responsável pelo arquivo RePEc global desta instalação OJS."

msgid "plugins.generic.repec.settings.supportEmailInUse"
msgstr "Se o e-mail do mantenedor não foi preenchido, o e-mail {$email} de suporte técnico configurado no OJS será utilizado."

msgid "plugins.generic.repec.settings.archiveCodeRequired"
msgstr "Informe o código do arquivo RePEc."

msgid "plugins.generic.repec.settings.archiveCodeInvalid"
msgstr "O código do arquivo RePEc deve ter exatamente 3 letras minúsculas."

msgid "plugins.generic.repec.settings.seriesCodeRequired"
msgstr "Informe o código da série."

msgid "plugins.generic.repec.settings.seriesCodeInvalid"
msgstr "O código da série deve ter exatamente 6 letras minúsculas ou dígitos."

msgid "plugins.generic.repec.settings.archiveNameRequired"
msgstr "Informe o nome do arquivo."

msgid "plugins.generic.repec.settings.seriesNameRequired"
msgstr "Informe o nome da série ou revista."

msgid "plugins.generic.repec.settings.providerNameRequired"
msgstr "Informe o nome do provedor."

msgid "plugins.generic.repec.settings.providerHomepageRequired"
msgstr "Informe a página inicial do provedor."

msgid "plugins.generic.repec.settings.maintainerNameRequired"
msgstr "Informe o nome do mantenedor."

msgid "plugins.generic.repec.settings.maintainerEmailInvalid"
msgstr "Informe um e-mail válido para o mantenedor."

msgid "plugins.generic.repec.settings.maintainerEmailRequired"
msgstr "Informe o e-mail do responsável pelo arquivo RePEc."

msgid "plugins.generic.repec.settings.globalJournals"
msgstr "Revistas neste arquivo RePEc"

msgid "plugins.generic.repec.settings.globalJournalsDescription"
msgstr "Selecione as revistas que serão publicadas no arquivo global desta instalação OJS. Revistas com configuração RePEc individual não podem ser selecionadas."

msgid "plugins.generic.repec.settings.globalJournalUnavailable"
msgstr "Esta revista já tem uma configuração RePEc individual."

msgid "plugins.generic.repec.settings.globalJournalsInvalid"
msgstr "Selecione pelo menos uma revista e informe um código de série único com 6 caracteres para cada revista selecionada."

msgid "plugins.generic.repec.settings.managedByGlobalArchive"
msgstr "Esta revista está configurada no arquivo RePEc global {$archiveCode}. As configurações RePEc individuais estão desabilitadas para esta revista."

msgid "plugins.generic.repec.settings.advanced"
msgstr "Avançado"

msgid "plugins.generic.repec.settings.advancedWarningLabel"
msgstr "Cuidado:"

msgid "plugins.generic.repec.settings.advancedWarning"
msgstr "mudanças nessa área são arriscadas e devem ser feitas com cuidado redobrado. Não mexa se não houver certeza."

msgid "plugins.generic.repec.settings.articleHandlePattern"
msgstr "Padrão do handle dos artigos"

msgid "plugins.generic.repec.settings.articleHandlePatternDescription"
msgstr "Opcional. Informe apenas o sufixo do handle, sem RePEc, código do arquivo ou código da série. Tokens aceitos: %v para volume, %Y para ano, %i para número da edição e %a para ID da submissão. O token %a é obrigatório para manter handles únicos por artigo."

msgid "plugins.generic.repec.settings.articleHandlePatternLockedDescription"
msgstr "Este padrão já foi salvo e não pode ser alterado pelo formulário."

msgid "plugins.generic.repec.settings.articleHandlePatternPreview"
msgstr "Prévia do handle"

msgid "plugins.generic.repec.settings.articleHandlePatternWarning"
msgstr "Handles já publicados não devem mudar. Configure este padrão antes de publicar os arquivos RePEc da revista."

msgid "plugins.generic.repec.settings.articleHandlePatternConfirm"
msgstr "Este padrão será usado para gerar handles públicos de artigos e não poderá ser alterado pelo formulário depois de salvo. Prévia: __PREVIEW__. Deseja salvar este padrão?"

msgid "plugins.generic.repec.settings.articleHandlePatternInvalid"
msgstr "Informe apenas o sufixo do handle, sem RePEc, usando caracteres válidos e os tokens %v, %Y, %i e %a. O token %a é obrigatório."

msgid "plugins.generic.repec.settings.removeIndividualSettings"
msgstr "Remover configurações individuais \"archiveCode\" e \"seriesCode\" para que a revista possa ser disponibilizada via configuração global do site."

msgid "plugins.generic.repec.settings.removeIndividualSettingsConfirm"
msgstr "Isso removerá as configurações individuais archiveCode e seriesCode desta revista. Depois disso, a revista poderá ser selecionada na configuração global do site. Deseja continuar?"

msgid "plugins.generic.repec.settings.legacyHandles"
msgstr "Handles RePEc legados"

msgid "plugins.generic.repec.settings.legacyHandlesDescription"
msgstr "Opcional. Importe um objeto JSON que mapeia IDs de submissão do OJS para handles RePEc publicados anteriormente. Esses handles sobrescrevem os handles gerados pelo plugin para esta revista."

msgid "plugins.generic.repec.settings.legacyHandlesCount"
msgstr "Handles legados configurados: {$count}."

msgid "plugins.generic.repec.settings.legacyHandlesDownload"
msgstr "Baixar JSON atual"

msgid "plugins.generic.repec.settings.legacyHandlesFile"
msgstr "Importar arquivo JSON"

msgid "plugins.generic.repec.settings.legacyHandlesJson"
msgstr "Conteúdo JSON para importar"

msgid "plugins.generic.repec.settings.legacyHandlesInvalid"
msgstr "Importe um objeto JSON válido usando IDs de submissão do OJS como chaves e handles RePEc completos como valores."

msgid "plugins.generic.repec.settings.legacyHandlesJsonInvalid"
msgstr "Importe um objeto JSON."

msgid "plugins.generic.repec.settings.legacyHandlesIdInvalid"
msgstr "Cada chave de handle legado deve ser um ID de submissão positivo do OJS."

msgid "plugins.generic.repec.settings.legacyHandlesHandleInvalid"
msgstr "Cada valor de handle legado deve ser um handle RePEc completo."

msgid "plugins.generic.repec.settings.legacyHandlesEmpty"
msgstr "O JSON de handles legados deve conter pelo menos um handle."
