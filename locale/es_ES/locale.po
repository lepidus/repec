msgid "plugins.generic.repec.displayName"
msgstr "Generador de ReDIF para RePEc"

msgid "plugins.generic.repec.description"
msgstr "Publica metadatos de la revista en formato ReDIF para su indexación en RePEc."

msgid "plugins.generic.repec.settings.description"
msgstr "Configure los datos mínimos del archivo RePEc de la revista. El plugin publica dinámicamente los archivos requeridos por RePEc para los artículos publicados e infiere los demás campos a partir de la configuración de la revista en OJS."

msgid "plugins.generic.repec.settings.publicUrl"
msgstr "URL pública:"

msgid "plugins.generic.repec.settings.archive"
msgstr "Archivo RePEc"

msgid "plugins.generic.repec.settings.series"
msgstr "Serie o revista"

msgid "plugins.generic.repec.settings.maintainer"
msgstr "Mantenedor"

msgid "plugins.generic.repec.settings.requiredData"
msgstr "Datos necesarios para configurar el plugin RePEc"

msgid "plugins.generic.repec.settings.repecScopeNotice"
msgstr "RePEc está destinado a la literatura de Economía y ciencias relacionadas. Antes de publicar cualquier archivo RePEc, siga las"

msgid "plugins.generic.repec.settings.repecScopeNoticeLink"
msgstr "instrucciones oficiales paso a paso de RePEc"

msgid "plugins.generic.repec.settings.archiveCode"
msgstr "Código de archivo asignado oficialmente por RePEc"

msgid "plugins.generic.repec.settings.archiveCodeDescription"
msgstr "No invente este código ni use un código perteneciente a otra institución. Solicite el código de archivo a RePEc antes de configurar el plugin."

msgid "plugins.generic.repec.settings.archiveName"
msgstr "Nombre del archivo"

msgid "plugins.generic.repec.settings.archiveDescription"
msgstr "Descripción"

msgid "plugins.generic.repec.settings.seriesCode"
msgstr "Código de 6 caracteres para la serie (revista)"

msgid "plugins.generic.repec.settings.seriesCodeDescription"
msgstr "Puede completarlo manualmente o usar la sugerencia automática. Después de publicarlo en RePEc, evite cambiar este código."

msgid "plugins.generic.repec.settings.generateSeriesCode"
msgstr "Generar automáticamente"

msgid "plugins.generic.repec.settings.seriesName"
msgstr "Nombre de la serie o revista"

msgid "plugins.generic.repec.settings.providerName"
msgstr "Nombre del proveedor"

msgid "plugins.generic.repec.settings.providerHomepage"
msgstr "Página inicial del proveedor"

msgid "plugins.generic.repec.settings.providerInstitution"
msgstr "Handle RePEc de la institución"

msgid "plugins.generic.repec.settings.maintainerName"
msgstr "Nombre del mantenedor"

msgid "plugins.generic.repec.settings.maintainerEmail"
msgstr "Correo electrónico del mantenedor"

msgid "plugins.generic.repec.settings.maintainerEmailDescription"
msgstr "Opcional. Si se deja vacío, el plugin usará el correo electrónico de soporte técnico configurado para la revista en OJS; si este también está vacío, usará el correo electrónico principal de contacto de la revista."

msgid "plugins.generic.repec.settings.maintainerEmailGlobalDescription"
msgstr "Obligatorio. Se usará como correo electrónico de la persona responsable del archivo RePEc global de esta instalación OJS."

msgid "plugins.generic.repec.settings.supportEmailInUse"
msgstr "Sí el correo electrónico del mantenedor no fue completado, se usará el correo electrónico de soporte técnico configurado en OJS: {$email}."

msgid "plugins.generic.repec.settings.archiveCodeRequired"
msgstr "Informe el código del archivo RePEc."

msgid "plugins.generic.repec.settings.archiveCodeInvalid"
msgstr "El código del archivo RePEc debe tener exactamente 3 letras minúsculas."

msgid "plugins.generic.repec.settings.seriesCodeRequired"
msgstr "Informe el código de la serie."

msgid "plugins.generic.repec.settings.seriesCodeInvalid"
msgstr "El código de la serie debe tener exactamente 6 letras minúsculas o dígitos."

msgid "plugins.generic.repec.settings.archiveNameRequired"
msgstr "Informe el nombre del archivo."

msgid "plugins.generic.repec.settings.seriesNameRequired"
msgstr "Informe el nombre de la serie o revista."

msgid "plugins.generic.repec.settings.providerNameRequired"
msgstr "Informe el nombre del proveedor."

msgid "plugins.generic.repec.settings.providerHomepageRequired"
msgstr "Informe la página inicial del proveedor."

msgid "plugins.generic.repec.settings.maintainerNameRequired"
msgstr "Informe el nombre del mantenedor."

msgid "plugins.generic.repec.settings.maintainerEmailInvalid"
msgstr "Informe un correo electrónico válido para el mantenedor."

msgid "plugins.generic.repec.settings.maintainerEmailRequired"
msgstr "Informe el correo electrónico de la persona responsable del archivo RePEc."

msgid "plugins.generic.repec.settings.globalJournals"
msgstr "Revistas en este archivo RePEc"

msgid "plugins.generic.repec.settings.globalJournalsDescription"
msgstr "Seleccione las revistas que se publicarán en el archivo global de esta instalación OJS. Las revistas con una configuración RePEc individual no se pueden seleccionar."

msgid "plugins.generic.repec.settings.globalJournalUnavailable"
msgstr "Esta revista ya tiene una configuración RePEc individual."

msgid "plugins.generic.repec.settings.globalJournalsInvalid"
msgstr "Seleccione al menos una revista e informe un código de serie único de 6 caracteres para cada revista seleccionada."

msgid "plugins.generic.repec.settings.managedByGlobalArchive"
msgstr "Esta revista está configurada en el archivo RePEc global {$archiveCode}. La configuración RePEc individual está deshabilitada para esta revista."

msgid "plugins.generic.repec.settings.advanced"
msgstr "Avanzado"

msgid "plugins.generic.repec.settings.advancedWarningLabel"
msgstr "Cuidado:"

msgid "plugins.generic.repec.settings.advancedWarning"
msgstr "los cambios en esta área son riesgosos y deben hacerse con cuidado redoblado. No cambie nada si no tiene certeza."

msgid "plugins.generic.repec.settings.articleHandlePattern"
msgstr "Patrón del handle de los artículos"

msgid "plugins.generic.repec.settings.articleHandlePatternDescription"
msgstr "Opcional. Informe solo el sufijo del handle, sin RePEc, código del archivo ni código de la serie. Tokens aceptados: %v para volumen, %Y para año, %i para número de edición y %a para ID del envío. El token %a es obligatorio para mantener handles únicos por artículo."

msgid "plugins.generic.repec.settings.articleHandlePatternLockedDescription"
msgstr "Este patrón ya fue guardado y no se puede cambiar en el formulario."

msgid "plugins.generic.repec.settings.articleHandlePatternPreview"
msgstr "Vista previa del handle"

msgid "plugins.generic.repec.settings.articleHandlePatternWarning"
msgstr "Los handles ya publicados no deben cambiar. Configure este patrón antes de publicar los archivos RePEc de la revista."

msgid "plugins.generic.repec.settings.articleHandlePatternConfirm"
msgstr "Este patrón se usará para generar handles públicos de artículos y no se podrá cambiar en el formulario después de guardarlo. Vista previa: __PREVIEW__. ¿Desea guardar este patrón?"

msgid "plugins.generic.repec.settings.articleHandlePatternInvalid"
msgstr "Informe solo el sufijo del handle, sin RePEc, usando caracteres válidos y los tokens %v, %Y, %i y %a. El token %a es obligatorio."

msgid "plugins.generic.repec.settings.removeIndividualSettings"
msgstr "Eliminar configuraciones individuales \"archiveCode\" y \"seriesCode\" para que la revista pueda estar disponible mediante la configuración global del sitio."

msgid "plugins.generic.repec.settings.removeIndividualSettingsConfirm"
msgstr "Esto eliminará las configuraciones individuales archiveCode y seriesCode de esta revista. Después de eso, la revista podrá seleccionarse en la configuración global del sitio. ¿Desea continuar?"

msgid "plugins.generic.repec.settings.legacyHandles"
msgstr "Handles RePEc heredados"

msgid "plugins.generic.repec.settings.legacyHandlesDescription"
msgstr "Opcional. Importe un objeto JSON que asigna IDs de envío de OJS a handles RePEc publicados anteriormente. Estos handles sobrescriben los handles generados por el plugin para esta revista."

msgid "plugins.generic.repec.settings.legacyHandlesCount"
msgstr "Handles heredados configurados: {$count}."

msgid "plugins.generic.repec.settings.legacyHandlesDownload"
msgstr "Descargar JSON actual"

msgid "plugins.generic.repec.settings.legacyHandlesFile"
msgstr "Importar archivo JSON"

msgid "plugins.generic.repec.settings.legacyHandlesJson"
msgstr "Contenido JSON para importar"

msgid "plugins.generic.repec.settings.legacyHandlesInvalid"
msgstr "Importe un objeto JSON válido usando IDs de envío de OJS como claves y handles RePEc completos como valores."

msgid "plugins.generic.repec.settings.legacyHandlesJsonInvalid"
msgstr "Importe un objeto JSON."

msgid "plugins.generic.repec.settings.legacyHandlesIdInvalid"
msgstr "Cada clave de handle heredado debe ser un ID de envío positivo de OJS."

msgid "plugins.generic.repec.settings.legacyHandlesHandleInvalid"
msgstr "Cada valor de handle heredado debe ser un handle RePEc completo."

msgid "plugins.generic.repec.settings.legacyHandlesEmpty"
msgstr "El JSON de handles heredados debe contener al menos un handle."
