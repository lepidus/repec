msgid "plugins.generic.repec.displayName"
msgstr "ReDIF Generator for RePEc"

msgid "plugins.generic.repec.description"
msgstr "Publishes journal metadata in ReDIF format for RePEc indexing."

msgid "plugins.generic.repec.settings.description"
msgstr "Configure the minimum RePEc archive data for the journal. The plugin dynamically publishes the files required by RePEc for published articles and infers the remaining fields from the journal settings in OJS."

msgid "plugins.generic.repec.settings.publicUrl"
msgstr "Public URL:"

msgid "plugins.generic.repec.settings.archive"
msgstr "RePEc archive"

msgid "plugins.generic.repec.settings.series"
msgstr "Series or journal"

msgid "plugins.generic.repec.settings.maintainer"
msgstr "Maintainer"

msgid "plugins.generic.repec.settings.requiredData"
msgstr "Data required to configure the RePEc plugin"

msgid "plugins.generic.repec.settings.repecScopeNotice"
msgstr "RePEc is intended for Economics literature and related sciences. Before publishing any RePEc files, follow the"

msgid "plugins.generic.repec.settings.repecScopeNoticeLink"
msgstr "official RePEc step-by-step instructions"

msgid "plugins.generic.repec.settings.archiveCode"
msgstr "Archive code officially assigned by RePEc"

msgid "plugins.generic.repec.settings.archiveCodeDescription"
msgstr "Do not invent this code, and do not use a code that belongs to another institution. Request the archive code from RePEc before configuring the plugin."

msgid "plugins.generic.repec.settings.archiveName"
msgstr "Archive name"

msgid "plugins.generic.repec.settings.archiveDescription"
msgstr "Description"

msgid "plugins.generic.repec.settings.seriesCode"
msgstr "6-character code for the series (journal)"

msgid "plugins.generic.repec.settings.seriesCodeDescription"
msgstr "You may fill this manually or use the automatic suggestion. After it is published in RePEc, avoid changing this code."

msgid "plugins.generic.repec.settings.generateSeriesCode"
msgstr "Generate automatically"

msgid "plugins.generic.repec.settings.seriesName"
msgstr "Series or journal name"

msgid "plugins.generic.repec.settings.providerName"
msgstr "Provider name"

msgid "plugins.generic.repec.settings.providerHomepage"
msgstr "Provider homepage"

msgid "plugins.generic.repec.settings.providerInstitution"
msgstr "Institution RePEc handle"

msgid "plugins.generic.repec.settings.maintainerName"
msgstr "Maintainer name"

msgid "plugins.generic.repec.settings.maintainerEmail"
msgstr "Maintainer email"

msgid "plugins.generic.repec.settings.maintainerEmailDescription"
msgstr "Optional. If left empty, the plugin will use the technical support email configured for the journal in OJS; if that is also empty, it will use the journal's main contact email."

msgid "plugins.generic.repec.settings.maintainerEmailGlobalDescription"
msgstr "Required. This will be used as the email of the person responsible for the global RePEc archive in this OJS installation."

msgid "plugins.generic.repec.settings.supportEmailInUse"
msgstr "If the maintainer email is empty, the technical support email configured in OJS will be used: {$email}."

msgid "plugins.generic.repec.settings.archiveCodeRequired"
msgstr "Enter the RePEc archive code."

msgid "plugins.generic.repec.settings.archiveCodeInvalid"
msgstr "The RePEc archive code must have exactly 3 lowercase letters."

msgid "plugins.generic.repec.settings.seriesCodeRequired"
msgstr "Enter the series code."

msgid "plugins.generic.repec.settings.seriesCodeInvalid"
msgstr "The series code must have exactly 6 lowercase letters or digits."

msgid "plugins.generic.repec.settings.archiveNameRequired"
msgstr "Enter the archive name."

msgid "plugins.generic.repec.settings.seriesNameRequired"
msgstr "Enter the series or journal name."

msgid "plugins.generic.repec.settings.providerNameRequired"
msgstr "Enter the provider name."

msgid "plugins.generic.repec.settings.providerHomepageRequired"
msgstr "Enter the provider homepage."

msgid "plugins.generic.repec.settings.maintainerNameRequired"
msgstr "Enter the maintainer name."

msgid "plugins.generic.repec.settings.maintainerEmailInvalid"
msgstr "Enter a valid maintainer email."

msgid "plugins.generic.repec.settings.maintainerEmailRequired"
msgstr "Enter the email of the person responsible for the RePEc archive."

msgid "plugins.generic.repec.settings.globalJournals"
msgstr "Journals in this RePEc archive"

msgid "plugins.generic.repec.settings.globalJournalsDescription"
msgstr "Select the journals that will be published in the global archive for this OJS installation. Journals with an individual RePEc configuration cannot be selected."

msgid "plugins.generic.repec.settings.globalJournalUnavailable"
msgstr "This journal already has an individual RePEc configuration."

msgid "plugins.generic.repec.settings.globalJournalsInvalid"
msgstr "Select at least one journal and enter a unique 6-character series code for each selected journal."

msgid "plugins.generic.repec.settings.managedByGlobalArchive"
msgstr "This journal is configured in the global RePEc archive {$archiveCode}. Individual RePEc settings are disabled for this journal."

msgid "plugins.generic.repec.settings.advanced"
msgstr "Advanced"

msgid "plugins.generic.repec.settings.advancedWarningLabel"
msgstr "Careful:"

msgid "plugins.generic.repec.settings.advancedWarning"
msgstr "changes in this area are risky and must be made with extra care. Do not change anything unless you are certain."

msgid "plugins.generic.repec.settings.articleHandlePattern"
msgstr "Article handle pattern"

msgid "plugins.generic.repec.settings.articleHandlePatternDescription"
msgstr "Optional. Enter only the handle suffix, without RePEc, archive code, or series code. Accepted tokens: %v for volume, %Y for year, %i for issue number, and %a for submission ID. The %a token is required to keep article handles unique."

msgid "plugins.generic.repec.settings.articleHandlePatternLockedDescription"
msgstr "This pattern has already been saved and cannot be changed in the form."

msgid "plugins.generic.repec.settings.articleHandlePatternPreview"
msgstr "Handle preview"

msgid "plugins.generic.repec.settings.articleHandlePatternWarning"
msgstr "Published handles should not change. Configure this pattern before publishing the journal's RePEc files."

msgid "plugins.generic.repec.settings.articleHandlePatternConfirm"
msgstr "This pattern will be used to generate public article handles and cannot be changed in the form after it is saved. Preview: __PREVIEW__. Do you want to save this pattern?"

msgid "plugins.generic.repec.settings.articleHandlePatternInvalid"
msgstr "Enter only the handle suffix, without RePEc, using valid characters and the tokens %v, %Y, %i, and %a. The %a token is required."

msgid "plugins.generic.repec.settings.removeIndividualSettings"
msgstr "Remove individual \"archiveCode\" and \"seriesCode\" settings so the journal can be made available through the site's global configuration."

msgid "plugins.generic.repec.settings.removeIndividualSettingsConfirm"
msgstr "This will remove the individual archiveCode and seriesCode settings from this journal. After that, the journal can be selected in the site's global configuration. Do you want to continue?"

msgid "plugins.generic.repec.settings.legacyHandles"
msgstr "Legacy RePEc handles"

msgid "plugins.generic.repec.settings.legacyHandlesDescription"
msgstr "Optional. Import a JSON object that maps OJS submission IDs to previously published RePEc handles. These handles override the handles generated by the plugin for this journal."

msgid "plugins.generic.repec.settings.legacyHandlesCount"
msgstr "Legacy handles configured: {$count}."

msgid "plugins.generic.repec.settings.legacyHandlesDownload"
msgstr "Download current JSON"

msgid "plugins.generic.repec.settings.legacyHandlesFile"
msgstr "Import JSON file"

msgid "plugins.generic.repec.settings.legacyHandlesJson"
msgstr "JSON content to import"

msgid "plugins.generic.repec.settings.legacyHandlesInvalid"
msgstr "Import a valid JSON object using OJS submission IDs as keys and full RePEc handles as values."

msgid "plugins.generic.repec.settings.legacyHandlesJsonInvalid"
msgstr "Import a JSON object."

msgid "plugins.generic.repec.settings.legacyHandlesIdInvalid"
msgstr "Each legacy handle key must be a positive OJS submission ID."

msgid "plugins.generic.repec.settings.legacyHandlesHandleInvalid"
msgstr "Each legacy handle value must be a full RePEc handle."

msgid "plugins.generic.repec.settings.legacyHandlesEmpty"
msgstr "The legacy handle JSON must contain at least one handle."
